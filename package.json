{
  "name": "kvitt",
  "version": "0.1.0",
  "description": "Split shared expenses in a group and see who should pay whom.",
  "keywords": [
    "expenses",
    "split",
    "settlement",
    "web-app"
  ],
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "test:match": "vitest run -t",
    "lint": "eslint ./src --cache",
    "lint:fix": "eslint ./src --cache --fix",
    "format": "prettier --write ./src",
    "format:check": "prettier ./src --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edvinkaradzas/kvitt.git"
  },
  "bugs": {
    "url": "https://github.com/edvinkaradzas/kvitt/issues"
  },
  "homepage": "https://github.com/edvinkaradzas/kvitt#readme",
  "author": "Edvin Karadza",
  "contributors": [
    "1dv610 Organization"
  ],
  "license": "Unlicense",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lnu/eslint-config": "^2.0.13",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^64.3.10",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-regexp": "^3.3.0",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "ejs": "^7.0.1",
    "express": "^5.3.0",
    "split-ledger": "^1.1.0"
  }
}
