<% const errors = locals.errors ?? {} %>
<% const form = locals.form ?? {} %>
<!DOCTYPE html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kvitt</title>
  </head>
  <body>
    <h1>Kvitt</h1>
    <p>Välkommen till Kvitt!</p>
    <form method="post" action="/groups">
      <label for="name">Gruppens namn</label>
      <input id="name" name="name" value="<%= form.name ?? '' %>" />
      <% if (errors.name) { %>
        <p class="error"><%= errors.name %></p>
      <% } %>
      <button>Skapa grupp</button>
    </form>
  </body>
</html>
