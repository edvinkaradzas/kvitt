<!DOCTYPE html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Nytt utlägg – <%= name %> – Kvitt</title>
  </head>
  <body>
    <a href="/groups/<%= id %>">Tillbaka till <%= name %></a>
    <h1>Nytt utlägg</h1>

    <form method="post" action="/groups/<%= id %>/expenses">
      <p>
        <label for="description">Vad</label>
        <input id="description" name="description" />
      </p>

      <p>
        <label for="amount">Belopp (kr)</label>
        <input id="amount" name="amount" inputmode="decimal" />
      </p>

      <p>
        <label for="paid-by">Vem betalade</label>
        <select id="paid-by" name="paidBy">
          <% for (const member of members) { %>
            <option><%= member %></option>
          <% } %>
        </select>
      </p>

      <fieldset>
        <legend>Hur ska utlägget delas? Välj ett av två sätt.</legend>
        <label>
          <input type="radio" name="split" value="equal" checked />
          Alternativ 1: Lika mellan de som kryssas i
        </label>
        <label>
          <input type="radio" name="split" value="exact" />
          Alternativ 2: Ett exakt belopp per person
        </label>
      </fieldset>

      <fieldset>
        <legend>Alternativ 1: Vilka delar lika?</legend>
        <% for (const member of members) { %>
          <label>
            <input type="checkbox" name="participants" value="<%= member %>" checked />
            <%= member %>
          </label>
        <% } %>
      </fieldset>

      <fieldset>
        <legend>Alternativ 2: Hur mycket står var och en för?</legend>
        <p>Beloppen ska tillsammans bli hela summan. Lämna tomt för den som inte är med.</p>
        <% for (const member of members) { %>
          <label>
            <%= member %>
            <input name="exactAmounts[<%= member %>]" inputmode="decimal" />
          </label>
        <% } %>
      </fieldset>

      <p>
        Ska några dela lika och andra betala olika belopp? Lägg in det som två utlägg.
      </p>

      <button>Lägg till utlägg</button>
    </form>
  </body>
</html>
