<!DOCTYPE html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= name %> – Kvitt</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/simpledotcss@2.3.7/simple.min.css" />
    <style>
      .error { color: #c62828; margin-top: 0; }
    </style>
  </head>
  <body>
    <a href="/">Till startsidan</a>
    <h1><%= name %></h1>

    <section>
      <h2>Medlemmar</h2>
      <% if (members.length === 0) { %>
        <p>Inga medlemmar än.</p>
      <% } else { %>
        <ul>
          <% for (const member of members) { %>
            <li><%= member %></li>
          <% } %>
        </ul>
      <% } %>

      <form method="post" action="/groups/<%= id %>/members">
        <label for="member-name">Namn</label>
        <input id="member-name" name="name" />
        <% if (errors.name) { %>
          <p class="error"><%= errors.name %></p>
        <% } %>
        <button>Lägg till medlem</button>
      </form>
    </section>

    <% if (members.length > 0) { %>
      <section>
        <h2>Utlägg</h2>
        <% if (expenses.length === 0) { %>
          <p>Inga utlägg än.</p>
        <% } else { %>
          <table>
            <thead>
              <tr>
                <th>Vad</th>
                <th>Belopp</th>
                <th>Betalt av</th>
                <th>Delas av</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% for (const expense of expenses) { %>
                <tr>
                  <td><%= expense.description %></td>
                  <td><%= expense.amount %></td>
                  <td><%= expense.paidBy %></td>
                  <td><%= expense.participants %></td>
                  <td>
                    <form method="post" action="/groups/<%= id %>/expenses/<%= expense.id %>/delete">
                      <button>Ta bort</button>
                    </form>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        <% } %>

        <a href="/groups/<%= id %>/expenses/new">Nytt utlägg</a>
      </section>
    <% } %>

    <% if (expenses.length > 0) { %>
      <section>
        <h2>Saldon</h2>
        <table>
          <tbody>
            <% for (const balance of balances) { %>
              <tr>
                <td><%= balance.name %></td>
                <td><%= balance.status %></td>
                <td><%= balance.amount %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </section>

      <section>
        <h2>Vem betalar vem</h2>
        <% if (transfers.length === 0) { %>
          <p>Alla är kvitt.</p>
        <% } else { %>
          <ul>
            <% for (const transfer of transfers) { %>
              <li><%= transfer.from %> betalar <%= transfer.to %> <%= transfer.amount %></li>
            <% } %>
          </ul>
        <% } %>
      </section>
    <% } %>
  </body>
</html>
