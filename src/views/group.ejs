<!DOCTYPE html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= name %> – Kvitt</title>
  </head>
  <body>
    <a href="/">Till startsidan</a>
    <h1><%= name %></h1>

    <section>
      <h2>Utlägg</h2>
      <% if (expenses.length === 0) { %>
        <p>Inga utlägg än.</p>
      <% } else { %>
        <table>
          <thead>
            <tr>
              <th>Vad</th>
              <th>Belopp</th>
              <th>Betalt av</th>
              <th>Delas av</th>
            </tr>
          </thead>
          <tbody>
            <% for (const expense of expenses) { %>
              <tr>
                <td><%= expense.description %></td>
                <td><%= expense.amount %></td>
                <td><%= expense.paidBy %></td>
                <td><%= expense.participants %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      <% } %>

      <a href="/groups/<%= id %>/expenses/new">Nytt utlägg</a>
    </section>

    <section>
      <h2>Medlemmar</h2>
      <% if (members.length === 0) { %>
        <p>Inga medlemmar än.</p>
      <% } else { %>
        <ul>
          <% for (const member of members) { %>
            <li><%= member %></li>
          <% } %>
        </ul>
      <% } %>

      <form method="post" action="/groups/<%= id %>/members">
        <label for="member-name">Namn</label>
        <input id="member-name" name="name" />
        <button>Lägg till medlem</button>
      </form>
    </section>
  </body>
</html>
